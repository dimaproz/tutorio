# PostgreSQL: the local development database (docker-compose.yml, pnpm db:up).
# A deployed environment sets its own service's URL instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutorio?schema=public"
# Optional, development only: the database pnpm db:sync copies into the local
# one (read-only; the Railway dev database's public URL).
# DEV_DB_SOURCE_URL=

# HTTP
PORT=4000
# Allowed CORS origins, comma-separated (never falls back to "*")
WEB_ORIGIN=http://localhost:3000

# Auth — generate each secret with: openssl rand -hex 32 (min 32 chars, must differ)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=tutorio-api
JWT_AUDIENCE=tutorio-clients

# Rate limiting. Authenticated traffic is limited per session and route;
# public auth routes per client address (raise only for test runs).
# THROTTLE_DEFAULT_LIMIT=600
# THROTTLE_AUTH_LIMIT=5
# THROTTLE_REFRESH_LIMIT=20

# Shared secret the web gateway sends as x-gateway-secret (same value as the
# web GATEWAY_SHARED_SECRET; min 16 chars, e.g. openssl rand -hex 32). When set,
# the API trusts the forwarded client address only from the gateway. When
# unset, forwarded addresses are trusted outside production only, so set it in
# production or login limits fall back to the gateway's own address.
GATEWAY_SHARED_SECRET=

# Sentry (empty = disabled)
SENTRY_DSN=
