generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspacePlan {
  FREE
  PRO

  @@map("workspace_plan")
}

// Presentation mode, not a data-model fork: lessons always carry a teacher.
// SOLO hides every teacher control and implies the owner's own profile.
enum WorkspaceMode {
  SOLO
  SCHOOL

  @@map("workspace_mode")
}

enum WorkspaceRole {
  OWNER
  TEACHER

  @@map("workspace_role")
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("enrollment_status")
}

// How a direction is paid (product/scheduling.md L-10): package credits, or
// each lesson's price on the direction's balance.
enum BillingType {
  PACKAGE
  PER_LESSON

  @@map("billing_type")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE

  @@map("audit_action")
}

// ON_HOLD hides the student from active lists without soft-deleting
// (distinct from deletedAt, which means "actually removed").
enum StudentStatus {
  ACTIVE
  ON_HOLD
  ARCHIVED

  @@map("student_status")
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED_CHARGED
  CANCELLED_UNCHARGED
  // The student did not come without notice (individual lessons). Charged
  // like a held lesson; shown as a miss.
  NO_SHOW

  @@map("lesson_status")
}

// A makeup is an individual lesson given in place of a cancelled or no-show
// one; exactly one of the pair is charged.
enum LessonKind {
  REGULAR
  MAKEUP

  @@map("lesson_kind")
}

enum CancelledBy {
  TEACHER
  STUDENT
  GROUP

  @@map("cancelled_by")
}

// ARCHIVED hides a teacher from active pickers without deleting their history
// (distinct from deletedAt).
enum TeacherStatus {
  ACTIVE
  ARCHIVED

  @@map("teacher_status")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  memberships  WorkspaceMember[]
  authSessions AuthSession[]
  auditLogs    AuditLog[]

  creditEntries   LessonCreditEntry[]
  payments        Payment[]
  attendanceMarks LessonAttendance[]

  @@map("users")
}

model Workspace {
  id                        String        @id @default(uuid())
  name                      String
  plan                      WorkspacePlan @default(FREE)
  mode                      WorkspaceMode @default(SOLO)
  defaultCurrency           String        @default("EUR")
  cancellationDeadlineHours Int           @default(24)
  // Default IANA timezone for new lesson series; Stage 8 adds the settings UI.
  timezone                  String        @default("Europe/Kyiv")
  // How many weeks ahead new schedules generate lessons (product/scheduling.md L-120).
  scheduleHorizonWeeks      Int           @default(4)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  deletedAt                 DateTime?

  members      WorkspaceMember[]
  authSessions AuthSession[]
  students     Student[]
  parents      Parent[]
  teachers     Teacher[]
  groups       Group[]
  enrollments  Enrollment[]
  auditLogs    AuditLog[]
  lessons      Lesson[]
  lessonSeries LessonSeries[]
  schedules    Schedule[]

  packages      LessonPackage[]
  creditEntries LessonCreditEntry[]
  charges       LessonCharge[]
  payments      Payment[]
  attendance    LessonAttendance[]

  @@map("workspaces")
}

// Authorization lives here: a user has a role only within a workspace,
// never globally on User.
model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  teacherProfile Teacher?

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// One row per login/registration. Stores only the HMAC of the current
// refresh token; rotation swaps the hash, reuse of a rotated token revokes
// the whole session.
model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  workspaceId      String
  refreshTokenHash String
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Student {
  id               String        @id @default(uuid())
  workspaceId      String
  fullName         String
  // Not unique: siblings may share a contact.
  email            String?
  phone            String?
  timezone         String
  telegramUsername String?
  // Free-text label validated against a curated list at the app layer
  // (@tutorio/validation), not a DB enum — the catalogue is expected to grow.
  subject          String?
  // Default price/currency for this student's enrollments; Enrollment.priceMinor
  // is the per-enrollment override, non-negative (DB CHECK below).
  hourlyRateMinor  Int?
  currency         String?
  status           StudentStatus @default(ACTIVE)
  // Free-text labels validated against curated enums at the app layer.
  languageLevel    String?
  knowledgeLevel   String?
  age              Int?
  grade            Int?
  // One of a curated set of bundled illustration keys (validated at the app
  // layer), e.g. "user-3" — never a free-form URL. Null = show initials.
  avatarKey        String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  // A business archive is represented by status. This timestamp correlates
  // only the future series/lessons suspended by that archive for safe restore.
  archivedAt       DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  enrollments Enrollment[]
  parents     StudentParent[]
  packages    LessonPackage[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, fullName])
  @@index([workspaceId, updatedAt])
  @@map("students")
}

// Parent/guardian entity, decoupled from Student (a parent may have several
// children in the same workspace). Replaces the old flat
// Student.parentName/parentEmail/parentPhone columns.
model Parent {
  id               String    @id @default(uuid())
  workspaceId      String
  fullName         String
  email            String?
  phone            String?
  telegramUsername String?
  // One of a curated set of bundled illustration keys — see Student.avatarKey.
  avatarKey        String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  students  StudentParent[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, fullName])
  @@index([workspaceId, updatedAt])
  @@map("parents")
}

// Many-to-many join: a student may have several parents, a parent may have
// several students. Removing a link deletes the row outright — there is no
// soft-delete concept for a relationship.
model StudentParent {
  id        String   @id @default(uuid())
  studentId String
  parentId  String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
  parent  Parent  @relation(fields: [parentId], references: [id])

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
  @@map("student_parents")
}

model Group {
  id                    String    @id @default(uuid())
  workspaceId           String
  name                  String
  notes                 String?
  // Group-level default price/currency; Enrollment.priceMinor is the
  // per-enrollment override, non-negative (DB CHECK below).
  pricePerLesson        Int?
  currency              String?
  // The teacher who runs the group: the default for new roster enrollments and
  // for the group's recurring schedule. Null only for a group created before
  // this column existed and never given a roster or a schedule.
  teacherId             String?
  // How many seats the group has; null means the tutor did not set a limit.
  // Informational only — the roster is never refused for being full.
  capacity              Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  // Correlates only work suspended because this group temporarily had no
  // eligible participants. It is deliberately separate from deletedAt.
  rosterSuspensionToken String?

  workspace    Workspace      @relation(fields: [workspaceId], references: [id])
  teacher      Teacher?       @relation("GroupTeacher", fields: [teacherId], references: [id])
  enrollments  Enrollment[]
  lessons      Lesson[]
  lessonSeries LessonSeries[]
  schedules    Schedule[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, name])
  @@index([teacherId])
  @@index([workspaceId, updatedAt])
  @@map("groups")
}

// Student participation in a group (groupId set) or individual lessons with a
// teacher (groupId null). All financial entities in later stages hang off the
// enrollment, never off the group.
model Enrollment {
  id                         String            @id @default(uuid())
  workspaceId                String
  studentId                  String
  groupId                    String?
  // The teacher is a workspace member, not a bare user: authorization and
  // teacher identity are workspace-scoped.
  teacherId                  String
  status                     EnrollmentStatus  @default(ACTIVE)
  // A new direction pays per lesson until its first package (L-10).
  billingType                BillingType       @default(PER_LESSON)
  // Price per lesson in minor units of `currency`; non-negative (DB CHECK).
  priceMinor                 Int
  currency                   String
  // Overrides Workspace.cancellationDeadlineHours; null = inherit the default.
  cancellationDeadlineHours  Int?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  deletedAt                  DateTime?
  // Set only while a student's archive operation temporarily suspends a group
  // membership. These markers make restore precise without clearing groupId.
  studentArchivedAt          DateTime?
  statusBeforeStudentArchive EnrollmentStatus?
  // Correlates operational schedule suspension with the lifecycle command
  // (pause, archive, or soft deletion) that caused it.
  scheduleSuspensionToken    String?

  workspace    Workspace      @relation(fields: [workspaceId], references: [id])
  student      Student        @relation(fields: [studentId], references: [id])
  group        Group?         @relation(fields: [groupId], references: [id])
  teacher      Teacher        @relation("EnrollmentTeacher", fields: [teacherId], references: [id])
  lessons      Lesson[]
  lessonSeries LessonSeries[]
  schedules    Schedule[]

  packages   LessonPackage[]
  charges    LessonCharge[]
  payments   Payment[]
  attendance LessonAttendance[]

  // Uniqueness among non-deleted rows only (one active enrollment per
  // student+group, one active individual enrollment per student+teacher) is
  // enforced by partial unique indexes added as raw SQL in the Stage 2
  // migration — Prisma cannot express partial indexes.
  @@index([workspaceId, deletedAt])
  @@index([studentId])
  @@index([groupId])
  @@index([teacherId])
  @@map("enrollments")
}

// Append-only: no updatedAt/deletedAt on purpose. actorId is null for
// system-initiated changes (cron jobs, migrations).
model AuditLog {
  id          String      @id @default(uuid())
  workspaceId String
  actorId     String?
  entity      String
  entityId    String
  action      AuditAction
  diff        Json?
  createdAt   DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  actor     User?     @relation(fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entity, entityId])
  @@map("audit_logs")
}

// A teaching profile, decoupled from the login account. Enrollment/Lesson/
// LessonSeries.teacherId reference this, not WorkspaceMember. A teacher may
// have no login (workspaceMemberId null) — a hired tutor tracked for scheduling
// and billing without an account. subjects/color are validated at the app layer.
model Teacher {
  id                String        @id @default(uuid())
  workspaceId       String
  fullName          String
  email             String?
  phone             String?
  telegramUsername  String?
  subjects          String[]
  bio               String?
  // Default per-lesson rate (minor units) prefilled onto new enrollments.
  defaultRateMinor  Int?
  currency          String?
  // Hex tint (#RRGGBB) for this teacher's calendar events.
  color             String?
  avatarKey         String?
  status            TeacherStatus @default(ACTIVE)
  // Optional link to a login account; unique so one member maps to one profile.
  workspaceMemberId String?       @unique
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  workspaceMember WorkspaceMember? @relation(fields: [workspaceMemberId], references: [id])
  enrollments     Enrollment[]     @relation("EnrollmentTeacher")
  groups          Group[]          @relation("GroupTeacher")
  lessons         Lesson[]         @relation("LessonTeacher")
  lessonSeries    LessonSeries[]   @relation("LessonSeriesTeacher")
  schedules       Schedule[]       @relation("ScheduleTeacher")

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, fullName])
  @@index([workspaceId, status])
  @@map("teachers")
}

// A recurring lesson pattern stored in local time (weekday + wall-clock time +
// tz); concrete Lessons are materialized to UTC over a rolling horizon by the
// cron job. Exactly one of enrollmentId / groupId is set.
model LessonSeries {
  id                       String    @id @default(uuid())
  workspaceId              String
  enrollmentId             String?
  groupId                  String?
  // Denormalized from the enrollment/group so conflict detection and calendar
  // filtering hit an index without joining.
  teacherId                String
  weekdays                 Int[]
  localTime                String
  timezone                 String
  durationMin              Int
  priceMinor               Int
  currency                 String
  startDate                DateTime
  // Exclusive upper boundary for materialization. Null means an open series.
  endsAt                   DateTime?
  horizonMaterializedUntil DateTime
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?
  // Set only when an enrollment or an empty group roster suspends this rule.
  scheduleSuspensionToken  String?
  // The schedule this row belongs to: one row per weekday and per version
  // (a change ends the current rows and starts new ones from its date).
  scheduleId               String

  workspace  Workspace   @relation(fields: [workspaceId], references: [id])
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])
  group      Group?      @relation(fields: [groupId], references: [id])
  teacher    Teacher     @relation("LessonSeriesTeacher", fields: [teacherId], references: [id])
  schedule   Schedule    @relation(fields: [scheduleId], references: [id])
  lessons    Lesson[]

  @@index([scheduleId])
  @@index([workspaceId, deletedAt])
  @@index([enrollmentId])
  @@index([groupId])
  @@index([teacherId])
  @@map("lesson_series")
}

enum ScheduleState {
  ACTIVE
  // Stopped: its end date has passed. A direction may then get a new one.
  ENDED

  @@map("schedule_state")
}

// A recurring schedule of one direction (product/scheduling.md L-20…L-27): a
// student with one teacher, or a group. Its rule lives in LessonSeries rows —
// one per weekday, each with its own start time — and a change from a date
// ends the current rows and starts new ones. One ACTIVE schedule per
// enrollment and per group (partial unique indexes in the migration).
model Schedule {
  id           String        @id @default(uuid())
  workspaceId  String
  enrollmentId String?
  groupId      String?
  teacherId    String
  timezone     String
  durationMin  Int
  // How many weeks ahead lessons are kept generated.
  horizonWeeks Int
  // Exclusive end instant ("until 31 May"); null runs until stopped.
  endsAt       DateTime?
  state        ScheduleState @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id])
  enrollment Enrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  group      Group?         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  teacher    Teacher        @relation("ScheduleTeacher", fields: [teacherId], references: [id])
  series     LessonSeries[]

  @@index([workspaceId, state])
  @@index([enrollmentId])
  @@index([groupId])
  @@index([teacherId])
  @@map("schedules")
}

// A concrete lesson at a UTC instant. Generated from a LessonSeries or created
// as a one-off (seriesId null). isDetached marks a series lesson that was
// rescheduled/cancelled individually and must not be regenerated. What each
// participant pays for it is a LessonCharge.
model Lesson {
  id                      String       @id @default(uuid())
  workspaceId             String
  enrollmentId            String?
  groupId                 String?
  seriesId                String?
  teacherId               String
  startsAtUtc             DateTime
  durationMin             Int
  priceMinor              Int
  currency                String
  status                  LessonStatus @default(SCHEDULED)
  kind                    LessonKind   @default(REGULAR)
  // The lesson a makeup replaces; one makeup per original.
  originalLessonId        String?      @unique
  // A short title shown in the calendar and lists; notes hold the rest.
  topic                   String?      @db.VarChar(200)
  // Incremented by each status transition. Combined with a conditional update,
  // this is the durable identity of a financial transition.
  statusVersion           Int          @default(0)
  isDetached              Boolean      @default(false)
  // Reschedule history, kept as counters because no LessonStatus expresses
  // "moved": a rescheduled lesson stays SCHEDULED, and isDetached is also set
  // when a single lesson leaves its series for any other reason. Stage 5
  // analytics buckets lessons by these instead of parsing AuditLog.diff.
  rescheduledCount        Int          @default(0)
  rescheduledAt           DateTime?
  cancelledBy             CancelledBy?
  cancelledReason         String?
  cancelledAt             DateTime?
  completedAt             DateTime?
  // When the money for this lesson arrived. Only meaningful for lessons billed
  // one by one — package lessons are paid through the package's own Payment
  // rows. Null on a completed lesson reads as "paid on the day".
  paidAt                  DateTime?
  notes                   String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  deletedAt               DateTime?
  // Set only when an enrollment or an empty group roster suspends this
  // otherwise-live scheduled occurrence. It makes restoration precise.
  scheduleSuspensionToken String?

  workspace  Workspace     @relation(fields: [workspaceId], references: [id])
  enrollment Enrollment?   @relation(fields: [enrollmentId], references: [id])
  group      Group?        @relation(fields: [groupId], references: [id])
  series     LessonSeries? @relation(fields: [seriesId], references: [id])
  teacher    Teacher       @relation("LessonTeacher", fields: [teacherId], references: [id])
  original   Lesson?       @relation("LessonMakeup", fields: [originalLessonId], references: [id], onDelete: SetNull)
  makeup     Lesson?       @relation("LessonMakeup")

  charges    LessonCharge[]
  attendance LessonAttendance[]

  // One materialized slot per series instant — the materializer's idempotency key.
  @@unique([seriesId, startsAtUtc])
  @@index([workspaceId, startsAtUtc])
  @@index([teacherId, startsAtUtc])
  @@index([seriesId])
  @@index([enrollmentId])
  @@index([groupId])
  @@map("lessons")
}

// Whether one participant was at one lesson. EXCUSED is an absence the tutor
// accepted in advance; it is neither a presence nor a miss in the rates.
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED

  @@map("attendance_status")
}

// One mark per (lesson, enrollment). A lesson's status stays the authority for
// whether it took place; attendance only says who was there. Marks are edited
// in place (the audit log keeps the history), never soft-deleted.
model LessonAttendance {
  id           String           @id @default(uuid())
  workspaceId  String
  lessonId     String
  enrollmentId String
  status       AttendanceStatus
  markedAt     DateTime         @default(now())
  markedById   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id])
  lesson     Lesson     @relation(fields: [lessonId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  markedBy   User?      @relation(fields: [markedById], references: [id])

  @@unique([lessonId, enrollmentId])
  @@index([enrollmentId])
  @@index([workspaceId])
  @@map("lesson_attendance")
}

// ---------------------------------------------------------------------------
// Stage 4 — packages, credit ledger, payments
//
// Two ledgers, never one: `Payment` is money (currency minor units) and
// `LessonCreditEntry` is lesson credits (±N lessons). "+200 EUR" and
// "+8 lessons" are different units and must not share a table.
// ---------------------------------------------------------------------------

// FIXED_COUNT: the tutor states how many lessons the package holds.
// BY_PERIOD: lessons are generated up to an end date from a recurring pattern.
enum PackageSizingMode {
  FIXED_COUNT
  BY_PERIOD

  @@map("package_sizing_mode")
}

enum PackagePaymentStatus {
  PENDING
  PARTIAL
  PAID

  @@map("package_payment_status")
}

// Mirrors @tutorio/domain LedgerEntryType. `purchase` credits the package;
// lesson_* entries are driven by the lesson state machine; manual_adjustment
// is the tutor's own correction (never an edit of an existing row).
enum CreditEntryType {
  purchase
  manual_adjustment

  @@map("credit_entry_type")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
  // Online acquiring (WayForPay/Stripe). The method a provider settled with.
  CARD

  @@map("payment_method")
}

// A manual payment is PAID the moment it is recorded — the tutor already has
// the money. An online payment starts PENDING and only becomes PAID when the
// provider confirms it, so the lifecycle has to exist before acquiring lands.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

// Prepaid lesson credits for one direction (an individual enrollment or a
// student's group membership; product/scheduling.md L-80). Its remaining
// credits are its credit entries minus the charges it pays for.
// `totalPriceMinorSnapshot` is the immutable purchase-time value.
model LessonPackage {
  id                          String               @id @default(uuid())
  workspaceId                 String
  // The direction the credits pay for; studentId is its student.
  enrollmentId                String
  studentId                   String
  name                        String?
  sizingMode                  PackageSizingMode    @default(FIXED_COUNT)
  // Set for FIXED_COUNT; for BY_PERIOD it holds the generated count.
  lessonsTotal                Int
  // Set for BY_PERIOD only.
  endDate                     DateTime?
  pricePerLessonMinorSnapshot Int
  totalPriceMinorSnapshot     Int
  currency                    String
  paymentStatus               PackagePaymentStatus @default(PENDING)
  purchasedAt                 DateTime             @default(now())
  expiresAt                   DateTime?
  notes                       String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  deletedAt                   DateTime?

  workspace     Workspace           @relation(fields: [workspaceId], references: [id])
  enrollment    Enrollment          @relation(fields: [enrollmentId], references: [id])
  student       Student             @relation(fields: [studentId], references: [id])
  creditEntries LessonCreditEntry[]
  charges       LessonCharge[]
  payments      Payment[]

  @@index([workspaceId, deletedAt])
  // Revenue by period scans packages by purchase date (Stage 5 analytics).
  @@index([workspaceId, purchasedAt])
  @@index([studentId])
  @@index([enrollmentId])
  @@map("lesson_packages")
}

// Append-only credit ledger, in lesson units. Never updated, never deleted: a
// correction is a new compensating row. `idempotencyKey` is what makes a
// double click, a retry or a replayed job safe.
model LessonCreditEntry {
  id             String          @id @default(uuid())
  workspaceId    String
  packageId      String
  delta          Int
  type           CreditEntryType
  idempotencyKey String          @unique
  note           String?
  createdById    String?
  createdAt      DateTime        @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  package   LessonPackage @relation(fields: [packageId], references: [id])
  createdBy User?         @relation(fields: [createdById], references: [id])

  @@index([packageId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("lesson_credit_entries")
}

// What pays for one participant's lesson (product/scheduling.md L-70, L-81,
// L-82, L-90).
enum ChargeSource {
  // One credit of packageId.
  PACKAGE
  // Package mode with no credits left: covered by the next credits.
  DEBT
  // Pay-per-lesson: amountMinor on the direction's balance.
  BALANCE

  @@map("charge_source")
}

// One participant's cost for one lesson: an individual lesson has one, a
// group lesson one per member taking part. The billing service re-evaluates
// it from the lesson's status, the makeup pairing and attendance; a charge no
// longer owed is voided (kept, with voidedAt) and revived if owed again.
model LessonCharge {
  id           String       @id @default(uuid())
  workspaceId  String
  lessonId     String
  enrollmentId String
  source       ChargeSource
  // Set exactly when source is PACKAGE (DB CHECK).
  packageId    String?
  // The participant's price for the lesson; the balance amount in
  // pay-per-lesson mode, informational for package credits.
  amountMinor  Int
  currency     String
  voidedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id])
  lesson     Lesson         @relation(fields: [lessonId], references: [id])
  enrollment Enrollment     @relation(fields: [enrollmentId], references: [id])
  package    LessonPackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@unique([lessonId, enrollmentId])
  @@index([enrollmentId, voidedAt])
  @@index([packageId])
  @@index([workspaceId])
  @@map("lesson_charges")
}

// The money ledger: an actual payment received, in currency minor units.
// Recording a payment never touches lesson credits directly.
model Payment {
  id             String        @id @default(uuid())
  workspaceId    String
  enrollmentId   String
  packageId      String?
  amountMinor    Int
  currency       String
  method         PaymentMethod @default(CASH)
  status         PaymentStatus @default(PAID)
  // Which PaymentProvider settled this. "manual" is the tutor writing down
  // money already received; an acquirer sets its own key here.
  provider       String        @default("manual")
  // The provider's own reference (order id / transaction id).
  externalId     String?
  // Guards against a replayed provider webhook recording the same money twice.
  // Null for manual entries, which are created by a human, one click at a time.
  idempotencyKey String?       @unique
  paidAt         DateTime      @default(now())
  note           String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  workspace  Workspace      @relation(fields: [workspaceId], references: [id])
  enrollment Enrollment     @relation(fields: [enrollmentId], references: [id])
  package    LessonPackage? @relation(fields: [packageId], references: [id])
  createdBy  User?          @relation(fields: [createdById], references: [id])

  @@index([workspaceId, paidAt])
  @@index([enrollmentId])
  @@index([packageId])
  @@index([provider, externalId])
  @@map("payments")
}
