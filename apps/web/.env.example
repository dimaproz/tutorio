# Server-only base URL of the Tutorio API (never exposed to the browser).
API_URL=http://localhost:4000/api

# Shared secret sent to the API as x-gateway-secret so it trusts the client
# address this gateway forwards for per-client rate limits. Must equal the
# API's GATEWAY_SHARED_SECRET (min 16 chars, e.g. openssl rand -hex 32).
# Optional locally; required in production.
GATEWAY_SHARED_SECRET=

# Sentry (empty = disabled)
NEXT_PUBLIC_SENTRY_DSN=
